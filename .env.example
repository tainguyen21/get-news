# Copy to .env and fill in the webhook URLs. .env is git-ignored; never commit it.
GCP_PROJECT=get-news-dg-261103
GCP_REGION=us-central1
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_HOT=
DISCORD_WEBHOOK_OPS=
# Local runs only: use the active gcloud user instead of application-default credentials.
GET_NEWS_GCLOUD_AUTH=1
# Monthly budget alert in the billing account's currency (check: gcloud billing accounts describe <id>).
BUDGET_AMOUNT=20USD
